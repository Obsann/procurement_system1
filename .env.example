# Create .env.example
cat << 'EOF' > .env.example
# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pmp_db
DB_USER=pmp_user
DB_PASSWORD=pmp_password
DB_HOST=localhost
DB_PORT=5432
EOF
